{
  "name": "chessview",
  "private": true,
  "scripts": {
    "dev": "npm run build:css && npm run sync:analyze && next dev --webpack",
    "build": "npm run build:css && npm run sync:analyze && next build",
    "start": "next start",
    "sync:analyze": "node scripts/sync-analyze-assets.mjs",
    "build:css": "tailwindcss -i ./standalone.tailwind.css -o ./standalone.css --minify",
    "build:analyze-css": "tailwindcss -i ./standalone.tailwind.css -o ./standalone.css --minify",
    "watch:css": "tailwindcss -i ./standalone.tailwind.css -o ./standalone.css --watch",
    "watch:analyze-css": "tailwindcss -i ./standalone.tailwind.css -o ./standalone.css --watch",
    "test:theme-backgrounds": "node scripts/check-theme-backgrounds.mjs",
    "test:analysis-multipv": "node scripts/check-analysis-multipv-snapshots.mjs",
    "validate:training-preludes": "node scripts/validate-training-preludes.mjs",
    "generate:training-corpus": "node scripts/generate-training-corpus.mjs",
    "audit:generated-training-corpus": "node scripts/audit-generated-training-corpus.mjs",
    "build:filler:random": "node scripts/build-random-position-filler-catalog.mjs",
    "build:filler:lichess": "node scripts/build-lichess-puzzle-filler-catalog.mjs",
    "db:query": "node --env-file=.env.agent.local scripts/db-query.mjs",
    "auth:agent-link": "node scripts/generate-agent-magic-link.mjs",
    "test:performance-time-management": "node --test --experimental-strip-types tests/performance-time-management.test.ts",
    "test:performance-client-analysis": "node --test --experimental-strip-types tests/performance-client-analysis.test.ts",
    "test:auth-magic-link": "node --test --experimental-strip-types tests/auth-magic-link.test.ts",
    "test:train-postmortem": "node --test --experimental-strip-types tests/train-postmortem-view-model.test.ts",
    "test:train-engine-line-cache": "node --test --experimental-strip-types tests/train-engine-line-cache.test.ts",
    "test:train": "npm run test:train-postmortem && npm run test:train-engine-line-cache",
    "index:build:10k": "python scripts/build-position-index-sample.py --limit 10000 && node --experimental-strip-types scripts/fingerprint-position-index.ts && node --experimental-strip-types scripts/build-compact-position-index.ts",
    "index:build:50k-games": "node scripts/build-50k-games-position-index.mjs",
    "index:build:full": "node scripts/build-full-position-index.mjs",
    "index:search": "node --experimental-strip-types scripts/search-position-index.ts",
    "index:benchmark:10k": "node --experimental-strip-types scripts/benchmark-position-index-search.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.58.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.100.1",
    "chess.js": "^1.4.0",
    "next": "^16.2.1",
    "pg": "^8.20.0",
    "posthog-js": "^1.372.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
